# Snap Camera Kit Configuration
# Get your API token from: https://camera-kit.snapchat.com/
VITE_SNAP_API_TOKEN=your_snap_api_token_here

# Group ID containing your lenses
VITE_SNAP_GROUP_ID=your_snap_group_id_here

# Snap Lens IDs for different styles
VITE_SNAP_LENS_NATURAL=your_natural_lens_id_here
VITE_SNAP_LENS_CATEYE=your_cateye_lens_id_here
VITE_SNAP_LENS_DRAMATIC=your_dramatic_lens_id_here

# Backend API URL
# Local development: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Payment & PromptPay Configuration
VITE_PROMPTPAY_ID=0812345678
VITE_PROMPTPAY_NAME=VyLash Official (บัญชีร้านค้า)
VITE_BANK_NAME=ธนาคารกสิกรไทย (KBANK)
VITE_BANK_ACCOUNT_NO=123-4-56789-0
VITE_BANK_ACCOUNT_NAME=VyLash Official
VITE_LINE_OA_URL=https://line.me/R/ti/p/@vylash
VITE_LINE_ID=@vylash
